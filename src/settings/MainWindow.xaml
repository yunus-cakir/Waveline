<Window x:Class="Waveline.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waveline Clip – Ayarlar" Width="640" Height="760" MinWidth="560" MinHeight="480"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Left" Content="Klasörü aç" Click="OpenFolder_Click" Margin="0,0,8,0"/>
        <Button DockPanel.Dock="Left" Content="Log" Click="OpenLog_Click"/>
        <Button DockPanel.Dock="Right" Content="Kaydet" Click="Save_Click" IsDefault="True" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="Kapat" Click="Close_Click" IsCancel="True"/>
        <TextBlock DockPanel.Dock="Right" x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Muted}"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
      <StackPanel>

        <!-- Geriye dönük kayıt -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Geriye dönük kayıt"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Süre"/>
              <!-- 15 s steps: 30 sn, 45 sn, 1 dk, 1 dk 15 sn ... 10 dk -->
              <Slider Grid.Column="1" x:Name="MinutesSlider" Minimum="0.5" Maximum="10" TickFrequency="0.25"
                      SmallChange="0.25" LargeChange="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ValueChanged="MinutesSlider_ValueChanged"/>
              <TextBlock Grid.Column="2" x:Name="MinutesText" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" x:Name="MemoryHint"/>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Klip klasörü"/>
              <TextBox Grid.Column="1" x:Name="DirBox"/>
              <Button Grid.Column="2" Content="Gözat…" Click="Browse_Click" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Kısayollar -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Kısayollar"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Klip kaydet"/>
              <TextBox Grid.Column="1" x:Name="ClipHotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="Kutuya tıklayıp yeni tuş kombinasyonuna basın"/>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Kaydı başlat/durdur"/>
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="RecordHotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="Kutuya tıklayıp yeni tuş kombinasyonuna basın"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Kutuya tıklayıp yeni kombinasyona basın (ör. Ctrl+Alt+F10). En az bir Ctrl/Alt/Shift/Win tuşu gerekir."/>
          </StackPanel>
        </Border>

        <!-- Video -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Video"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Codec"/>
              <ComboBox Grid.Column="1" x:Name="CodecBox" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Tag="hevc">HEVC (H.265) – önerilen</ComboBoxItem>
                <ComboBoxItem Tag="h264">H.264 – en uyumlu</ComboBoxItem>
              </ComboBox>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Kare hızı"/>
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FpsBox" Width="120" HorizontalAlignment="Left">
                <ComboBoxItem>30</ComboBoxItem>
                <ComboBoxItem>60</ComboBoxItem>
                <ComboBoxItem>120</ComboBoxItem>
                <ComboBoxItem>144</ComboBoxItem>
              </ComboBox>
              <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Bit hızı"/>
              <Slider Grid.Row="4" Grid.Column="1" x:Name="BitrateSlider" Minimum="5" Maximum="60" TickFrequency="1"
                      IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BitrateSlider_ValueChanged"/>
              <TextBlock Grid.Row="4" Grid.Column="2" x:Name="BitrateText" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <CheckBox x:Name="CursorBox" Content="Fare imlecini kaydet" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- Manuel kayıt -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Manuel kayıt"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="SplitBox" Content="Kaydı şu aralıkla yeni dosyaya böl:" Checked="SplitBox_Changed" Unchecked="SplitBox_Changed"/>
              <TextBox x:Name="SplitMinutesBox" Width="60" Margin="8,0,6,0"/>
              <TextBlock Text="dakika" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Masaüstü -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Masaüstü modu"/>
            <CheckBox x:Name="DesktopBox" Content="Oyun açık değilken masaüstünü de geriye dönük kaydet"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Monitör"/>
              <ComboBox Grid.Column="1" x:Name="MonitorBox" DisplayMemberPath="Label"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Bildirimler -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Bildirimler"/>
            <CheckBox x:Name="NotificationsBox" Content="Windows bildirimi göster"/>
            <CheckBox x:Name="SoundBox" Content="Bildirim sesi çal"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Ses cihazı"/>
              <ComboBox Grid.Column="1" x:Name="NotifyDeviceBox" DisplayMemberPath="Label"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Ses, Sonar kanallarına değil doğrudan kulaklığa çalınır; böylece kliplere girmez. 'Otomatik', Sonar'ın Personal Mix cihazını kullanır."/>
          </StackPanel>
        </Border>

        <!-- Oyunlar -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Oyun algılama"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="Tam ekran ya da kenarlıksız pencereler otomatik algılanır. Her satıra bir exe adı yazın (.exe olmadan da olur)."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Pencereli de olsa kaydet" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="IncludeBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Asla kaydetme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="ExcludeBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" x:Name="DefaultExcludesText"/>
          </StackPanel>
        </Border>

        <!-- Sistem -->
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Sistem"/>
            <CheckBox x:Name="AutostartBox" Content="Windows ile birlikte başlat"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
